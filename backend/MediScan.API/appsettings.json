{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mediscan_dev.db"
  },
  "Database": {
    "Provider": "sqlite",
    "Comment": "Change Provider to 'postgresql' and update DefaultConnection for production"
  },

  "Jwt": {
    "Secret": "MediScanDevSecretKey2024!ChangeInProduction32Chars",
    "Issuer": "MediScanAI",
    "Audience": "MediScanAIUsers",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Azure": {
    "StorageConnectionString": "",
    "ContainerName": "mediscan-scans",
    "OpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": "gpt-4o",
      "ApiVersion": "2024-02-01"
    }
  },

  "OpenFDA": {
    "ApiKey": ""
  },

  "AiServer": {
    "Url": "http://localhost:8000",
    "ApiKey": "internal-dev-key"
  },

  "Storage": {
    "LocalFallback": {
      "Enabled": true,
      "BasePath": "wwwroot/uploads"
    }
  },

  "AllowedOrigins": [
    "http://localhost:19006",
    "http://localhost:3000",
    "http://localhost:5173"
  ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
