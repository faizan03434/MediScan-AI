# ============================================================
# MediScan AI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!
# ============================================================

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mediscan_db
POSTGRES_USER=mediscan_user
POSTGRES_PASSWORD=your_strong_password_here

# ──────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ──────────────────────────────────────────────
# .NET API
# ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ISSUER=MediScanAI
JWT_AUDIENCE=MediScanAIUsers
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# ──────────────────────────────────────────────
# AZURE
# ──────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER_NAME=mediscan-scans

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ──────────────────────────────────────────────
# AI SERVER (FastAPI)
# ──────────────────────────────────────────────
AI_SERVER_URL=http://localhost:8000
AI_SERVER_API_KEY=your_internal_api_key_here

# ──────────────────────────────────────────────
# EXTERNAL APIs
# ──────────────────────────────────────────────
OPENFDA_API_KEY=your_openfda_key_here

# ──────────────────────────────────────────────
# APP CONFIG
# ──────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
ENCRYPTION_KEY=your_aes256_encryption_key_here
