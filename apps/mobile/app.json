{
  "expo": {
    "name": "MediScan AI",
    "slug": "mediscan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mediscan",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mediscan.ai",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MediScan AI needs camera access for medical detection scans.",
        "NSPhotoLibraryUsageDescription": "MediScan AI needs photo library access to analyze saved images.",
        "NSMicrophoneUsageDescription": "Microphone access is not used by this app."
      }
    },
    "android": {
      "package": "com.mediscan.ai",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 1
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
